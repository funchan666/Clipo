// Replace these two values with the registered backend and Apple identifiers.
// The bundle ID is provisional, as requested.
PRODUCT_BUNDLE_IDENTIFIER = com.clipo.video
CLIPO_API_HOST = devapi.io-jp.com
// Empty expansion preserves // in xcconfig URL values.
CLIPO_PRIVACY_URL = https:/$()/sites.google.com/view/clipo-privacypolicy/fendii
CLIPO_TERMS_URL = https:/$()/sites.google.com/view/clipo-terms-of-service/fendii
IPHONEOS_DEPLOYMENT_TARGET = 17.0
SWIFT_VERSION = 5.0
TARGETED_DEVICE_FAMILY = 1
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 7
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =
// Google official iOS demo configuration. Replace before publishing.
CLIPO_ADS_TEST_MODE = YES
CLIPO_GOOGLE_ADS_APP_ID = ca-app-pub-3940256099942544~1458002511
OTHER_LDFLAGS = $(inherited) -ObjC
