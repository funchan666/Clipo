// Keep the current signing identity for this test build.
// Service requests use the independently configured production package name.
PRODUCT_BUNDLE_IDENTIFIER = im.seex.lobo
CLIPO_API_HOST = b8pd8t.clipo.vip
CLIPO_SERVICE_PACKAGE_NAME = com.cliporows.toolskeep
// Empty expansion preserves // in xcconfig URL values.
CLIPO_PRIVACY_URL = https:/$()/www.clipo.vip/#privacy
CLIPO_TERMS_URL = https:/$()/www.clipo.vip/#terms
IPHONEOS_DEPLOYMENT_TARGET = 17.0
SWIFT_VERSION = 5.0
TARGETED_DEVICE_FAMILY = 1
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 7
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =
// Production App ID supplied on 2026-10-22; getV2 must return the same identity.
// Ad unit IDs continue to come only from getV2.
CLIPO_GOOGLE_ADS_APP_ID = ca-app-pub-4423220037289714~4213264017
OTHER_LDFLAGS = $(inherited) -ObjC
